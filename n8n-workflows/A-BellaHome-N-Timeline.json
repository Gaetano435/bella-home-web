      "position": [
        176,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Verificar Pin').first().json;\nconst proprieta = $('Leggi Proprieta Timeline').all().map(i => i.json);\nconst persone = $('Leggi Persone Timeline').all().map(i => i.json);\nconst checklist = $('Leggi Checklist Timeline').all().map(i => i.json).filter(c => String(c.pratica_id) === String(p.id));\n\nfunction nombresDe(val) {\n  if (val === null || val === undefined || val === '') return '';\n  const ids = String(val).split(/[,;]/).map(s => s.trim()).filter(Boolean);\n  const nombres = ids.map(id => {\n    const per = persone.find(x => String(x.id) === String(id));\n    return per ? per.nome_cognome : '(no encontrado)';\n  });\n  return nombres.join(', ');\n}\n\nconst prop = proprieta.find(x => String(x.id) === String(p.proprieta_id));\n\nconst praticaCompleta = Object.assign({}, p, {\n  codice_proprieta: prop ? prop.codice_proprieta : '',\n  proprieta_titolo: prop ? prop.titolo_indirizzo : '',\n  referencia_catastral: prop ? prop.referencia_catastral : '',\n  venditore_nome: nombresDe(p.venditori_ids) || '(non trovato)',\n  acquirente_nome: nombresDe(p.acquirenti_ids) || '(non trovato)'\n});\n\nreturn [{ json: { pratica: praticaCompleta, checklist: checklist } }];"
      },
