    {
      "parameters": {
        "jsCode": "const q = $('Webhook Datos Timeline').first().json.query || {};\nconst praticaId = Number(q.pratica_id);\nconst pin = q.pin;\n\nconst pratica = items.map(i => i.json).find(p => p.id === praticaId);\nif (!pratica) { throw new Error('No autorizado'); }\nif (!pratica.pin_acceso || String(pratica.pin_acceso) !== String(pin)) { throw new Error('No autorizado'); }\n\nreturn [{ json: pratica }];"
