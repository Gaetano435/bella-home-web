    {
      "parameters": {
        "jsCode": "const SECRET = 'BellaHome2026!Cvn';\nconst input = $('Webhook Upload Documento').first().json.body;\nconst checklistId = Number(input.checklist_id);\nconst voci = $('Leggi Voce Checklist').all().map(i => i.json);\nconst voce = voci.find(v => v.id === checklistId);\nif (!voce) throw new Error('Voce checklist non trovata: ' + checklistId);\nconst pratiche = $('Leggi Pratica Per Cartella').all().map(i => i.json);\nconst pratica = pratiche.find(p => p.id === voce.pratica_id);\nif (!pratica) throw new Error('Pratica non trovata per la voce checklist');\n\nconst autorizzatoGestionale = input.bella_auth === SECRET;\nconst autorizzatoCliente = input.pin && pratica.pin_acceso && String(pratica.pin_acceso) === String(input.pin) && Number(input.pratica_id) === pratica.id;\nif (!autorizzatoGestionale && !autorizzatoCliente) {\n  throw new Error('No autorizado');\n}\n\nlet cartellaId;\nif (voce.per_chi === 'Acquirente') cartellaId = pratica.cartella_acquirente_id;\nelse cartellaId = pratica.cartella_venditore_id;\nif (!cartellaId) cartellaId = pratica.cartella_id;\nif (!cartellaId) throw new Error('Esta pratica no tiene carpetas de Drive creadas todavia');\n\nconst webhookItem = $('Webhook Upload Documento').first();\nreturn [{ json: { checklistId, cartellaId }, binary: webhookItem.binary }];"
      },
