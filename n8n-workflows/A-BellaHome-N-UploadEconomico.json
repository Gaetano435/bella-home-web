        "jsCode": "const CAMPO_MAP = {\n  'reserva_contrato': 'reserva_contrato_file',\n  'reserva_comprobante': 'reserva_comprobante_file',\n  'arras_contrato': 'arras_contrato_file',\n  'arras_comprobante': 'arras_comprobante_file',\n  'traspaso': 'traspaso_comprobante_file'\n};\nconst input = $('Webhook Upload Economico').first().json.body;\nconst praticaId = Number(input.pratica_id);\nconst campo = input.campo;\nconst nomeColonna = CAMPO_MAP[campo];\nif (!nomeColonna) throw new Error('Campo economico non riconosciuto: ' + campo);\nconst pratiche = items.map(i => i.json);\nconst pratica = pratiche.find(p => p.id === praticaId);\nif (!pratica) throw new Error('Pratica non trovata: ' + praticaId);\nconst cartellaId = pratica.cartella_id;\nif (!cartellaId) throw new Error('Esta pratica no tiene carpeta de Drive creada todavia');\nconst webhookItem = $('Webhook Upload Economico').first();\nreturn [{ json: { praticaId, nomeColonna, cartellaId }, binary: webhookItem.binary }];"
