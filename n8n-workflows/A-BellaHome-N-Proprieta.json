      "parameters": {
        "jsCode": "const input = $('Webhook Crea Proprieta').first().json.body;\n\nconst existing = items.map(i => i.json.id).filter(v => typeof v === 'number');\nconst nextId = existing.length ? Math.max(...existing) + 1 : 1;\n\nconst anno = new Date().getFullYear();\nconst codiceAuto = 'BH-' + anno + '-' + String(nextId).padStart(3, '0');\nconst codice = (input.codice_proprieta && input.codice_proprieta.trim()) ? input.codice_proprieta.trim() : codiceAuto;\n\nreturn [{\n  json: {\n    id: nextId,\n    codice_proprieta: codice,\n    referencia_catastral: input.referencia_catastral || '',\n    titolo_indirizzo: input.titolo_indirizzo || '',\n    tipologia: input.tipologia || '',\n    camere_da_letto: input.camere_da_letto || 0,\n    bagni: input.bagni || 0,\n    superficie_m2: input.superficie_m2 || 0,\n    prezzo_richiesto: input.prezzo_richiesto || 0,\n    stato_annuncio: input.stato_annuncio || 'Disponibile',\n    proprietari_ids: input.proprietari_ids || '',\n    descrizione: input.descrizione || ''\n  }\n}];"
